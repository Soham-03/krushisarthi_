# ---------------------------------------------------------------
# KrushiSarthi settings. Copy this file to ".env" and fill in what you have.
# Everything is optional: with an empty file the app runs in DEMO mode.
# ---------------------------------------------------------------

APP_ENV=development            # set to "production" when you deploy
PORT=8000

# 1) Login (Clerk) -------------------------------------------------
# Clerk dashboard > API keys > Publishable key (starts with pk_test_ or pk_live_)
CLERK_PUBLISHABLE_KEY=

# 2) Satellite (Google Earth Engine) --------------------------------
# Your approved Earth Engine Cloud project ID (the "crop monitor" project)
EE_PROJECT=
# Option A (deploying / servers): service account
EE_SERVICE_ACCOUNT=            # e.g. crop-monitor@your-project.iam.gserviceaccount.com
EE_KEY_FILE=                   # path to the downloaded JSON key, e.g. ./ee-key.json
# Option B (your own laptop): leave the two lines above empty and run once:
#   earthengine authenticate

# 3) Weather (Open-Meteo) -------------------------------------------
# No key needed. Free for non-commercial use.

# 4) AI: assistant chat, leaf-photo detection, weekly checkup photos, soil-report reading
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-sonnet-5-5
CLAUDE_VISION_MODEL=claude-sonnet-5-5
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5   # used for the 30-40 weekly checkup photos

# 4b) AI assistant provider (default: Claude with the key above) ----------
# To use another provider, switch to openai_compat and fill the next three lines, for example:
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=<a Gemini model>
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1                                  LLM_MODEL=<a GPT model>
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1                                  LLM_MODEL=<a local model>
LLM_PROVIDER=anthropic         # anthropic | openai_compat
LLM_MODEL=                     # empty = use CLAUDE_CHAT_MODEL
LLM_BASE_URL=
LLM_API_KEY=
# Photo features (leaf scan, weekly checkup photos, soil report) use the same provider.
# Optional: pick a different model for them. The model MUST accept images.
LLM_VISION_MODEL=              # empty = use LLM_MODEL
LLM_TRIAGE_MODEL=              # cheaper model for the 30-40 weekly photos. empty = LLM_VISION_MODEL
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=5
CHAT_RATE_PER_MINUTE=20

# 4c) Knowledge base search (RAG) ------------------------------------------
# Keyword search works with no setup once you ingest documents (see README).
# For meaning-based search (helps Hindi and Marathi), add any OpenAI-compatible embeddings API:
EMBEDDING_BASE_URL=            # e.g. https://api.openai.com/v1   or   https://api.voyageai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
KB_TOP_K=5
KB_MIN_COSINE=0.35

# 5) Push notifications (Web Push) -----------------------------------
# Generate with:  python scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 6) Daily jobs from an outside scheduler (optional, for free hosting that sleeps)
CRON_SECRET=
